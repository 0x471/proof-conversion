#!/bin/bash

# SP1 Groth16 environment configuration
export WORK_DIR="sp1_groth16_test"
export CACHE_DIR="sp1_groth16_cache"

# Get the script directory to build proper paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# SP1 converted proof and VK paths (absolute paths)
export PROOF_PATH="$PROJECT_ROOT/pairing-utils/sp1_proof.json"
export VK_PATH="$PROJECT_ROOT/pairing-utils/sp1_vk.json"

# Note: RAW_VK_PATH is not needed for SP1 since alpha-beta is already computed in the converter
export RAW_VK_PATH=""

echo "SP1 Groth16 Environment:"
echo "  WORK_DIR: $WORK_DIR"
echo "  CACHE_DIR: $CACHE_DIR"
echo "  PROOF_PATH: $PROOF_PATH"
echo "  VK_PATH: $VK_PATH"
echo "  PROJECT_ROOT: $PROJECT_ROOT"